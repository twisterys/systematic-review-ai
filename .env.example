# LLM Configuration
# For Gemini (Recommended - Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# Optional alternative: OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Preferred Provider: "gemini" or "openai"
DEFAULT_LLM_PROVIDER=gemini

# Academic Search APIs (Optional but recommended for higher rate limits)
NCBI_API_KEY=your_ncbi_pubmed_api_key_here
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key_here
OPENALEX_EMAIL=your_email_for_polite_pool@example.com

# Persistence / Cache
CHROMA_DB_PATH=./output/chroma_db
OUTPUT_DIR=./output
